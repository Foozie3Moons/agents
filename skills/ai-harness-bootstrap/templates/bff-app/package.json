{
  "name": "app-name",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec concurrently -n nest,vite -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "tsx watch src/backend/main.ts",
    "dev:frontend": "pnpm --dir src/frontend dev",
    "build": "pnpm build:backend && pnpm build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "pnpm --dir src/frontend build",
    "typecheck": "tsc --noEmit && pnpm --dir src/frontend typecheck",
    "start": "node dist/src/backend/main.js",
    "test": "vitest run --passWithNoTests && pnpm --dir src/frontend test",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 && pnpm --dir src/frontend lint && pnpm --dir src/frontend lint:css",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs && pnpm --dir src/frontend depcruise",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "better-sqlite3": "~12.8.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.17",
    "@swc/core": "^1.15.24",
    "@types/better-sqlite3": "~7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "concurrently": "~9.2.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "tsx": "~4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "~3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@swc/core", "better-sqlite3", "esbuild", "msw", "unrs-resolver"]
  }
}
