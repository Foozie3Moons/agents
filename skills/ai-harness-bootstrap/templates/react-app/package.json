{
  "name": "app-name",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "! grep -rnE '^\\.(container|wrapper|box|inner|outer)\\s*\\{' src --include='*.module.css'",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm depcruise && pnpm test"
  },
  "dependencies": {
    "@tanstack/react-query": "~5.95.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "~7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.3.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/adapter-rsbuild": "^0.12.0",
    "@rstest/core": "^0.12.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.2",
    "msw": "^2.7.0",
    "storybook": "~10.6.6",
    "storybook-react-rsbuild": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@rspack/binding", "core-js", "msw", "unrs-resolver"]
  }
}
